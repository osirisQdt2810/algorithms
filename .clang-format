# dsa-journey C++ style — deliberately shaped around how the solutions in this repo are
# actually written, not around an off-the-shelf preset:
#   - access modifiers indented one level, members two (`class Solution { public: int f() }`)
#   - `else` kept on its own line after the closing brace
#   - includes never reordered, annotation comment blocks never rewrapped
#
# One unavoidable deviation: clang-format always puts a space between `)` and `{`, so
# `for (...){` becomes `for (...) {`. There is no option to disable that.
BasedOnStyle: LLVM
Language: Cpp

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 110

# class Solution {
#     public:
#         int f() { ... }
IndentAccessModifiers: true
NamespaceIndentation: None

# Do not inject/remove blank lines around `public:` / `private:` — keep what is written.
EmptyLineBeforeAccessModifier: Leave

# Attach braces everywhere except before `else` / `catch`, which stay on their own line.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false
  AfterStruct: false
  AfterUnion: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterControlStatement: Never
  AfterCaseLabel: false
  BeforeElse: true
  BeforeCatch: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false

PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements

# The include order is the solution template's, and the annotation blocks are hand-wrapped
# to a fixed column — leave both exactly as written.
SortIncludes: Never
ReflowComments: false
